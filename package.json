{
  "name": "digital-desk",
  "productName": "Digital Desk",
  "version": "0.1.0",
  "description": "Capture first. Organize never. Find later.",
  "author": {
    "name": "yoon-yoo-tak"
  },
  "homepage": "https://github.com/yoon-yoo-tak/digital-desk",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoon-yoo-tak/digital-desk.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build:helper": "bash native/desk-helper/build.sh",
    "build:tray-icons": "node scripts/build-tray-icons.mjs",
    "predev": "npm run build:helper && npm run build:tray-icons",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:helper && npm run build:tray-icons",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "seed": "electron-vite build && electron . --seed",
    "demo-assets": "node scripts/make-demo-assets.mjs",
    "demo": "electron-vite build && electron . --profile=demo",
    "build:mac:dir": "npm run build && electron-builder --mac --dir --arm64",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
